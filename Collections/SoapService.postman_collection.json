          "listen": "test",
          "script": {
            "exec": [
              "const xml2js = require('xml2js');\r",
              "let jsonData;\r",
              "xml2js.parseString(pm.response.text(), { explicitArray: false }, (err, result) => {\r",
              "    if (err) {\r",
              "        throw err;\r",
              "    }\r",
              "\r",
              "    jsonData = result;\r",
              "\r",
              "    console.log(jsonData);\r",
              "    pm.test(\"verify number to words\",()=>\r",
              "    {\r",
              "    const actualValue=jsonData[\"soap:Envelope\"][\"soap:Body\"][\"m:NumberToWordsResponse\"][\"m:NumberToWordsResult\"]\r",
              "    pm.expect(pm.collectionVariables.get(\"expectedvalue\")).to.eql(actualValue)\r",
              "    })\r",
              "    pm.test(\"parsing response\",()=>\r",
              "    {\r",
              "        pm.expect(pm.response.text()).to.include(pm.collectionVariables.get(\"expectedvalue\"))\r",
              "        pm.response.to.have.status(200);\r",
              "    })\r",
              "});\r",
              ""
            ],

  "item": [
    {
      "name": "AddPlace",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData=pm.response.json()\r",
              "pm.collectionVariables.set(\"place_id\",jsonData.place_id)\r",
              "\r",
              "pm.test(\"Validate response\",()=>\r",
              "{\r",
              "    pm.expect(jsonData.status).to.eql(\"OK\")\r",
              "    pm.expect(jsonData.scope).to.eql(\"APP\")\r",
              "    pm.response.status.to.eql(200)\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"location\": {\r\n    \"lat\": {{lat}},\r\n    \"lng\": 170.427362\r\n  },\r\n  \"accuracy\": 50,\r\n  \"name\": \"{{name}}\",\r\n  \"phone_number\": \"(+91) 123 456 7891\",\r\n  \"address\": \"{{address}}\",\r\n  \"types\": [\r\n    \"flower park\",\r\n    \"shop\"\r\n  ],\r\n  \"website\": \"http://google.com\",\r\n  \"language\": \"French-IN\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/maps/api/place/add/json?key={{key}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "maps",
            "api",
            "place",
            "add",
            "json"
          ],
          "query": [
            {
              "key": "key",
              "value": "{{key}}"
            }
          ]
        }
      },
      "response": []
    },

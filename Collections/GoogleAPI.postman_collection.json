          "listen": "test",
          "script": {
            "exec": [
              "const jsonData=pm.response.json()\r",
              "pm.test(\"Validate address response\",()=>\r",
              "{\r",
              "    pm.response.to.have.status(200)\r",
              "    pm.expect(jsonData.location.latitude).to.eql(pm.collectionVariables.get(\"lat\"))\r",
              "    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get(\"name\"))\r",
              "    pm.expect(jsonData.address).to.eql(pm.collectionVariables.get(\"address\"))\r",
              "}\r",
              ")"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }

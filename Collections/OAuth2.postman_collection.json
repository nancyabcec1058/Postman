        {
          "listen": "test",
          "script": {
            "exec": [
              "const jsonData={ \r",
              "    \"instructor\": \"RahulShetty\",\r",
              "    \"url\": \"rahulshettycademy.com\", \r",
              "    \"services\": \"projectSupport\", \r",
              "    \"expertise\": \"Automation\",\r",
              "    \"courses\": \r",
              "{ \"webAutomation\": \r",
              "[ \r",
              "    { \"courseTitle\": \"Selenium Webdriver Java\", \"price\": \"50\" }, \r",
              "    { \"courseTitle\": \"Cypress\",\"price\": \"40\"},\r",
              "    {\"courseTitle\": \"Protractor\",\"price\": \"40\"}\r",
              "],\r",
              "\"api\": \r",
              "[\r",
              "   {\"courseTitle\": \"Rest Assured Automation using Java\",\"price\": \"50\"},\r",
              "   {\"courseTitle\": \"SoapUI Webservices testing\",\"price\": \"40\"}\r",
              "],\r",
              "\"mobile\": [\r",
              "   {\"courseTitle\": \"Appium-Mobile Automation using Java\",\"price\": \"50\"}\r",
              "]\r",
              "},\r",
              "\"linkedIn\": \"https://www.linkedin.com/in/rahul-shetty-trainer/\"\r",
              "}\r",
              "const expectedCourses=[\"Selenium Webdriver Java\",\"Cypress\",\"Protractor\"]\r",
              "const actualCourses=[]\r",
              "var cypressObj;\r",
              "pm.test(\"course test\",()=>\r",
              "{\r",
              "    cypressObj=jsonData.courses.webAutomation.find(m=>m.courseTitle==='Cypress')\r",
              "    pm.expect(cypressObj).to.be.an('object')\r",
              "    \r",
              "})\r",
              "pm.test(\"verify cypress properties\",()=>\r",
              "{\r",
              "  pm.expect(cypressObj).to.have.all.keys(\"courseTitle\",\"price\")\r",
              "})\r",
              "pm.test(\"sum of api courses\",()=>\r",
              "{\r",
              "    let apiCourses=jsonData.courses.api\r",
              "    let total=apiCourses.reduce((sum,course)=>sum+Number(course.price),0)\r",
              "    console.log(total);\r",
              "    let sum=0;\r",
              "    for(let i=0;i<apiCourses.length;i++)\r",
              "    {\r",
              "        sum=sum+parseInt(apiCourses[i].price);\r",
              "    }\r",
              "    console.log(sum);\r",
              "})\r",
              "\r",
              "pm.test(\"Validate web courses title\",()=>\r",
              "{\r",
              "    jsonData.courses.webAutomation.map(m=>actualCourses.push(m.courseTitle))\r",
              "    console.log(actualCourses);\r",
              "    pm.expect(expectedCourses).to.be.eql(actualCourses);\r",
              "\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}

    {
      "name": "Query",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "graphql",
          "graphql": {
            "query": "query($characterId:Int!,$episodeId:Int!,$locationId:Int!)\r\n{\r\n  character(characterId: $characterId) {\r\n    name\r\n    gender\r\n    status\r\n    id\r\n  }\r\n  location(locationId: $locationId) {\r\n    name\r\n    dimension\r\n  }\r\n  episode(episodeId: $episodeId) {\r\n    name\r\n    air_date\r\n    episode\r\n  }\r\n  characters(filters:{name:\"{{characterName}}\"})\r\n  {\r\n    info\r\n    {\r\n      count\r\n    }\r\n    result\r\n    {\r\n      name\r\n      type\r\n    }\r\n    \r\n  }\r\n  episodes(filters:{name:\"{{episodeName}}\"})\r\n  {\r\n    result\r\n    {\r\n      id\r\n      name\r\n      air_date\r\n    }\r\n  }\r\n}\r\n",
            "variables": "{\r\n  \"characterId\":{{characterId}},\r\n  \"episodeId\":{{episodeId}},\r\n  \"locationId\":{{locationId}}\r\n  \r\n}"
          }
        },
        "url": {
